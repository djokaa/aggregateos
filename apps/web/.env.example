# ===========================================================================
# AggregateOS — Environment Variables
# ===========================================================================
# Copy this file to .env.local and fill in actual values.
# Variables marked (required) must be set for the app to function.
# Variables marked (optional) enable additional features when set.
# ===========================================================================

# ---------------------------------------------------------------------------
# Authentication — Clerk (required for production, optional in dev)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ---------------------------------------------------------------------------
# Database — PostgreSQL via Supabase (required)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/aggregateos

# ---------------------------------------------------------------------------
# Google Maps Platform (optional — enables geocoding + distance calculation)
# ---------------------------------------------------------------------------
# Enable: Geocoding API, Distance Matrix API, Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# OCR — Google Document AI (optional — enables auto ticket reading)
# ---------------------------------------------------------------------------
# Create a Document AI processor at: console.cloud.google.com/ai/document-ai
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
# Service account token (or use Application Default Credentials)
GOOGLE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Email — Resend (optional — enables email delivery of estimates/invoices)
# ---------------------------------------------------------------------------
# Sign up at: resend.com
RESEND_API_KEY=
EMAIL_FROM=AggregateOS <noreply@aggregateos.com>

# ---------------------------------------------------------------------------
# SMS — Twilio (optional — enables driver SMS notifications)
# ---------------------------------------------------------------------------
# Sign up at: twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# Accounting — QuickBooks Online (optional — enables invoice sync)
# ---------------------------------------------------------------------------
# Register at: developer.intuit.com
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/integrations/quickbooks/callback
QBO_REALM_ID=
QBO_ACCESS_TOKEN=
QBO_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
